    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.58",
    "autoprefixer": "^10.5.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.30.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
